# ---------- Gmail OAuth 2.0 (read-only) ----------
# The ONLY mailbox the app will process. Authenticating as any other account is rejected.
TARGET_GMAIL_ADDRESS=rajurajuu970@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# Alternatively, you may place the downloaded OAuth Web Client JSON at this path:
GOOGLE_CLIENT_SECRETS_FILE=backend/secrets/client_secret.json
FRONTEND_URL=http://localhost:5173
# Fernet key for encrypting the stored OAuth token. Leave empty to auto-generate backend/secrets/fernet.key
TOKEN_ENCRYPTION_KEY=
# Max messages pulled on the first (full) sync, and background interval (0 = disabled)
SYNC_MAX_MESSAGES=200
SYNC_INTERVAL_MINUTES=0

# ---------- Database ----------
# SQLite for local dev; PostgreSQL for production, e.g. postgresql+psycopg2://user:pass@host:5432/leadsense
DATABASE_URL=sqlite:///./backend/leadsense.db

# ---------- LLM / embeddings (any OpenAI-compatible endpoint) ----------
# Leave OPENAI_API_KEY empty to run in clearly-labelled heuristic+RAG mode (no LLM call is made or claimed).
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# local = offline KB TF-IDF embeddings, openai = OpenAI-compatible embeddings API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DIR=./backend/chroma_db

# ---------- Behaviour ----------
DUPLICATE_THRESHOLD=90
DEFAULT_PHONE_REGION=IN
# Optional live homepage check for the company trust score (makes outbound HTTP requests)
ENABLE_WEBSITE_CHECK=false
# Optional shared access key; when set, API calls must send header X-API-Key
API_ACCESS_KEY=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
